.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
reports/
outputs/
*.docx
*.pptx

# Google Earth Engine service-account credentials -- never commit these.
secrets/
*.json.key
gee_service_account*.json
key_GEE/

# Raw/processed satellite data is typically large and not committed to git.
# Remove these lines if you intend to version-control the data itself.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
data/samples/*.tif
